<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.msservices.geopolitik.controllers.production.productionController"
            stylesheets="@../../styles/productionStyles/productionViewStyles.css">

    <center>
        <VBox spacing="12" alignment="TOP_CENTER" styleClass="main-container">

            <ImageView fx:id="productionIcon"
                       fitWidth="55"
                       fitHeight="55"
                       preserveRatio="true"
                       styleClass="production-icon"/>

            <Label text="Producción" styleClass="titulo"/>

            <ScrollPane fitToWidth="true" prefWidth="500" prefHeight="150" styleClass="panel-scroll">
                <VBox fx:id="productionStatusList" spacing="6" styleClass="lista lista-naranja"/>
            </ScrollPane>

            <Label fx:id="insufficientResourcesLabel"
                   text="Recursos insuficientes"
                   visible="false"
                   managed="false"
                   styleClass="warning-label"/>

            <ScrollPane fitToWidth="true" prefWidth="500" prefHeight="120" styleClass="panel-scroll">
                <HBox fx:id="queueList" spacing="10" alignment="CENTER_LEFT" styleClass="lista"/>
            </ScrollPane>

            <HBox fx:id="moneyRow" alignment="CENTER_RIGHT" spacing="6" prefWidth="500" visible="false" managed="false">
                <ImageView fx:id="moneyIcon" fitWidth="16" fitHeight="16" preserveRatio="true"/>
                <Label fx:id="moneyLabel" styleClass="texto-dato-claro"/>
            </HBox>

            <Label text="Producción en curso" styleClass="subtitulo"/>

            <ScrollPane fitToWidth="true" prefWidth="500" prefHeight="180" styleClass="panel-scroll">
                <VBox fx:id="productionList" spacing="6" styleClass="lista"/>
            </ScrollPane>

            <HBox alignment="CENTER_RIGHT" spacing="15" prefWidth="500">
                <Button fx:id="clearProductionButton"
                        text="Limpiar"
                        styleClass="boton-atras"/>
                <Button fx:id="backButton"
                        text="Atrás"
                        styleClass="boton-atras"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
