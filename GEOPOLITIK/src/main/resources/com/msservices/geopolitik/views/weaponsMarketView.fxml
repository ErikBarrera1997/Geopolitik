<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.msservices.geopolitik.controllers.WeaponsMarketControllers"
            stylesheets="/com/msservices/geopolitik/styles/weaponsMarketStyles.css">

    <center>
        <VBox spacing="15" styleClass="panel-mercado" prefWidth="360" maxWidth="400" minWidth="360">

            <VBox spacing="8" alignment="CENTER">
                <Rectangle fx:id="imagenIcono" width="60" height="60" styleClass="imagen-icono"/>
                <Label text="Mercado de armas" styleClass="titulo"/>
            </VBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Rectangle fx:id="imagenArma" width="40" height="40" styleClass="imagen-icono"/>
                <Label fx:id="etiquetaTexto" text="Nombre del arma" styleClass="etiqueta-texto"/>
            </HBox>

            <ComboBox fx:id="listaDesplegable" maxWidth="Infinity" prefHeight="30" styleClass="lista-desplegable"/>

            <VBox fx:id="cantidadPanel" managed="false" visible="false" spacing="10" alignment="CENTER_LEFT">
                <Label text="Cantidad" styleClass="subtitulo"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Slider fx:id="sliderCantidad" min="0" max="100" value="10" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="campoCantidad" prefWidth="60" styleClass="campo-cantidad"/>
                </HBox>
            </VBox>

            <Button fx:id="botonCantidad" text="Seleccionar cantidad" maxWidth="Infinity" styleClass="boton-cantidad" onAction="#onSeleccionarCantidad"/>

            <Button fx:id="botonComprar" text="Comprar" maxWidth="Infinity" styleClass="boton-comprar" onAction="#onComprarClick"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="botonNegro" text="Mercado negro" styleClass="boton-mercado-negro"/>
                <Button fx:id="botonRegresar" text="Regresar" styleClass="boton-regresar" onAction="#goBack"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
