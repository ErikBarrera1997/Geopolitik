<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.msservices.geopolitik.controllers.diplomacy.cancelTreatyController"
            stylesheets="/com/msservices/geopolitik/styles/diplomacyStyles/cancelTreatyStyles.css"
            minWidth="560" minHeight="470">

    <center>

        <VBox spacing="15"
              alignment="CENTER"
              styleClass="main-container">

            <!-- Title -->
            <Label fx:id="titleLabel"
                   text="Romper alianza"
                   styleClass="titulo"/>

            <!-- Flags + icon -->
            <HBox alignment="CENTER"
                  spacing="30">

                <Label fx:id="flag1"
                       prefWidth="120"
                       prefHeight="65"
                       styleClass="flag-label"/>

                <Label fx:id="optionIcon"
                       prefWidth="70"
                       prefHeight="70"
                       styleClass="icon-label"/>

                <Label fx:id="flag2"
                       prefWidth="120"
                       prefHeight="65"
                       styleClass="flag-label"/>

            </HBox>

            <!-- Information -->
            <Label fx:id="infoLabel"
                   wrapText="true"
                   prefWidth="460"
                   prefHeight="80"
                   alignment="TOP_LEFT"
                   styleClass="info-label"/>

            <!-- Affected treaties -->
            <Label text="Tratados afectados"
                   styleClass="section-title"/>

            <ScrollPane fitToWidth="true"
                        prefWidth="460"
                        prefHeight="120">
                <VBox fx:id="conflictList" spacing="5" styleClass="lista-scroll"/>
            </ScrollPane>

            <!-- Buttons -->
            <HBox spacing="30"
                  alignment="CENTER">

                <Button fx:id="acceptButton"
                        text="Romper alianza"
                        styleClass="primary-button"/>

                <Button fx:id="rejectButton"
                        text="Cancelar"
                        styleClass="secondary-button"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>
