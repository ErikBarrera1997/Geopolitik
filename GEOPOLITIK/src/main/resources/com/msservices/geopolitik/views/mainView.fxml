<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.msservices.geopolitik.controllers.MenuController"
            minWidth="800" minHeight="500">
    <stylesheets>
        /com/msservices/geopolitik/styles/mainViewStyles.css
    </stylesheets>

    <top>
        <MenuBar styleClass="menu-bar">
            <Menu text="Partida"/>
        </MenuBar>
    </top>

    <center>
        <HBox spacing="10" alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <ScrollPane fx:id="scrollMapa" HBox.hgrow="ALWAYS" styleClass="panel-principal">
                <Pane minWidth="400">
                    <ImageView fx:id="imagenPrincipal" preserveRatio="true" onMouseClicked="#onImagenPrincipalClick"/>
                </Pane>
            </ScrollPane>

            <VBox spacing="10" alignment="TOP_CENTER" minWidth="220" maxWidth="300">
                <HBox spacing="10" alignment="CENTER">
                    <Circle fx:id="etiquetaRoja" radius="25" styleClass="etiqueta-roja"/>
                    <Rectangle fx:id="etiquetaAzul" width="60" height="40" styleClass="etiqueta-azul"/>
                </HBox>

                <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" styleClass="panel-scroll">
                    <VBox fx:id="listaSuperior" spacing="5" styleClass="lista">
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <ImageView fitWidth="20" fitHeight="20"/>
                            <Label text="Elemento 1"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <ImageView fitWidth="20" fitHeight="20"/>
                            <Label text="Elemento 2"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <ImageView fitWidth="20" fitHeight="20"/>
                            <Label text="Elemento 3"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <ImageView fitWidth="20" fitHeight="20"/>
                            <Label text="Elemento 4"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <ImageView fitWidth="20" fitHeight="20"/>
                            <Label text="Elemento 5"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <ImageView fitWidth="20" fitHeight="20"/>
                            <Label text="Elemento 6"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <ImageView fitWidth="20" fitHeight="20"/>
                            <Label text="Elemento 7"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <ImageView fitWidth="20" fitHeight="20"/>
                            <Label text="Elemento 8"/>
                        </HBox>
                    </VBox>
                </ScrollPane>

                <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" styleClass="panel-scroll">
                    <VBox fx:id="listaInferior" spacing="5" styleClass="lista">
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <ImageView fitWidth="20" fitHeight="20"/>
                            <Label text="Mercado de armas"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <ImageView fitWidth="20" fitHeight="20"/>
                            <Label text="Investigación"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <ImageView fitWidth="20" fitHeight="20"/>
                            <Label text="Diplomacia"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <ImageView fitWidth="20" fitHeight="20"/>
                            <Label text="Acciones"/>
                        </HBox>
                    </VBox>
                </ScrollPane>

                <Button fx:id="botonEjecutar" text="Ejecutar" maxWidth="Infinity" styleClass="boton-ejecutar"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
