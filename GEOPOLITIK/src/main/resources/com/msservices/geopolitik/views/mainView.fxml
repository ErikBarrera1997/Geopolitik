<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.msservices.geopolitik.controllers.MenuController"
            minWidth="800" minHeight="500">
    <stylesheets>
        /com/msservices/geopolitik/styles/mainViewStyles.css
    </stylesheets>

    <top>
        <MenuBar styleClass="menu-bar">
            <Menu text="Partida"/>
            <Menu fx:id="menuMinistroGuerra" text="Ministro de guerra">
                <MenuItem text="Fuerzas armadas" onAction="#openWarMinister"/>
            </Menu>
            <Menu text="Ministro de economía"/>
            <Menu text="Mundo"/>
            <Menu text="Trucos"/>
            <Menu text="Ayuda"/>
        </MenuBar>
    </top>

    <center>
        <HBox spacing="10" alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <ScrollPane fx:id="scrollMapa" HBox.hgrow="ALWAYS" styleClass="panel-principal">
                <Pane minWidth="400">
                    <ImageView fx:id="imagenPrincipal" preserveRatio="true" onMouseClicked="#onImagenPrincipalClick"/>
                </Pane>
            </ScrollPane>

            <VBox spacing="10" alignment="TOP_CENTER" minWidth="220" maxWidth="300">
                <HBox spacing="10" alignment="CENTER">
                    <Circle fx:id="etiquetaRoja" radius="25" styleClass="etiqueta-roja"/>
                    <Rectangle fx:id="etiquetaAzul" width="60" height="40" styleClass="etiqueta-azul"/>
                </HBox>

                <!-- Poblacion y Finanzas fuera de la lista -->
                <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion" onMouseClicked="#onPoblacionClick">
                    <ImageView fx:id="iconPoblacion" fitWidth="28" fitHeight="28"/>
                    <Label fx:id="lblPoblacion" text="Población: 0"/>
                </HBox>
                <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion" onMouseClicked="#onFinanzasClick">
                    <ImageView fx:id="iconFinanzas" fitWidth="28" fitHeight="28"/>
                    <Label fx:id="lblFinanzas" text="Finanzas: 0"/>
                </HBox>

                <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" styleClass="panel-scroll">
                    <VBox fx:id="listaSuperior" spacing="8" styleClass="lista" fillWidth="true">
                        <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion">
                            <ImageView fitWidth="28" fitHeight="28"/>
                            <Label fx:id="lblArea" text="Área: 0"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion">
                            <ImageView fx:id="iconGasNatural" fitWidth="28" fitHeight="28"/>
                            <Label fx:id="lblGasNatural" text="Gas natural: 0"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion">
                            <ImageView fx:id="iconPetroleo" fitWidth="28" fitHeight="28"/>
                            <Label fx:id="lblPetroleo" text="Petróleo: 0"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion">
                            <ImageView fx:id="iconMadera" fitWidth="28" fitHeight="28"/>
                            <Label fx:id="lblMadera" text="Madera: 0"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion">
                            <ImageView fx:id="iconPesca" fitWidth="28" fitHeight="28"/>
                            <Label fx:id="lblPesca" text="Pesca: 0"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion">
                            <ImageView fx:id="iconUranio" fitWidth="28" fitHeight="28"/>
                            <Label fx:id="lblUranio" text="Uranio: 0"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion">
                            <ImageView fx:id="iconOro" fitWidth="28" fitHeight="28"/>
                            <Label fx:id="lblOro" text="Oro: 0"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion">
                            <ImageView fx:id="iconAgricultura" fitWidth="28" fitHeight="28"/>
                            <Label fx:id="lblAgricultura" text="Agricultura: 0"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion">
                            <ImageView fx:id="iconAcero" fitWidth="28" fitHeight="28"/>
                            <Label fx:id="lblAcero" text="Acero: 0"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion">
                            <ImageView fx:id="iconIndustria" fitWidth="28" fitHeight="28"/>
                            <Label fx:id="lblIndustria" text="Industria: 0"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion">
                            <ImageView fx:id="iconElectricidad" fitWidth="28" fitHeight="28"/>
                            <Label fx:id="lblElectricidad" text="Electricidad: 0"/>
                        </HBox>
                    </VBox>
                </ScrollPane>

                <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" styleClass="panel-scroll">
                    <VBox fx:id="listaInferior" spacing="8" styleClass="lista" fillWidth="true">
                        <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion" onMouseClicked="#onInferiorItemClick">
                            <ImageView fx:id="iconArmamento" fitWidth="28" fitHeight="28"/>
                            <Label text="Armamento"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion" onMouseClicked="#onInferiorItemClick">
                            <ImageView fx:id="iconAccionesMilitares" fitWidth="28" fitHeight="28"/>
                            <Label text="Acciones militares"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion" onMouseClicked="#onInferiorItemClick">
                            <ImageView fx:id="iconNoticias" fitWidth="28" fitHeight="28"/>
                            <Label text="Noticias"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion" onMouseClicked="#onInferiorItemClick">
                            <ImageView fx:id="iconProvincias" fitWidth="28" fitHeight="28"/>
                            <Label text="Provincias"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion" onMouseClicked="#onInferiorItemClick">
                            <ImageView fx:id="iconInvestigacion" fitWidth="28" fitHeight="28"/>
                            <Label text="Investigación"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion" onMouseClicked="#onInferiorItemClick">
                            <ImageView fx:id="iconDiplomacia" fitWidth="28" fitHeight="28"/>
                            <Label text="Diplomacia"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="fila-accion" onMouseClicked="#onInferiorItemClick">
                            <ImageView fx:id="iconMundo" fitWidth="28" fitHeight="28"/>
                            <Label text="Mundo"/>
                        </HBox>
                    </VBox>
                </ScrollPane>

                <Button fx:id="botonEjecutar" text="Ejecutar" maxWidth="Infinity" styleClass="boton-ejecutar"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
