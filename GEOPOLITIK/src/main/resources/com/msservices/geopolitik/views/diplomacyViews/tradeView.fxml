<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.TreatyController">

    <center>

        <VBox alignment="CENTER"
              spacing="15"
              styleClass="main-container">

            <!-- Treaty image -->
            <Label fx:id="treatyImage"
                   prefWidth="70"
                   prefHeight="70"
                   styleClass="image-label"/>

            <!-- Treaty name -->
            <Label text="Treaty"
                   fx:id="treatyNameLabel"/>

            <!-- Countries -->
            <HBox alignment="CENTER"
                  spacing="30">

                <Label fx:id="sourceCountryFlag"
                       prefWidth="100"
                       prefHeight="50"
                       styleClass="flag-label"/>

                <Label fx:id="treatyTypeImage"
                       prefWidth="60"
                       prefHeight="60"
                       styleClass="image-label"/>

                <Label fx:id="targetCountryFlag"
                       prefWidth="100"
                       prefHeight="50"
                       styleClass="flag-label"/>

            </HBox>

            <!-- Probability title -->
            <Label text="Success Probability"/>

            <!-- Gauge -->
            <Pane fx:id="probabilityGauge"
                  prefWidth="320"
                  prefHeight="40">

                <!-- Gauge background -->
                <Rectangle fx:id="gaugeBackground"
                           x="20"
                           y="14"
                           width="280"
                           height="12"/>

                <!-- Center marker -->
                <Line startX="160"
                      startY="8"
                      endX="160"
                      endY="32"/>

                <!-- Movable indicator -->
                <Line fx:id="probabilityIndicator"
                      startX="160"
                      startY="8"
                      endX="160"
                      endY="32"/>

            </Pane>

            <!-- Labels -->
            <HBox prefWidth="320">

                <Label text="Low"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="High"/>

            </HBox>

            <!-- Buttons -->
            <HBox alignment="CENTER"
                  spacing="20">

                <Button fx:id="signTreatyButton"
                        text="Sign Treaty"/>

                <Button fx:id="backButton"
                        text="Back"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>