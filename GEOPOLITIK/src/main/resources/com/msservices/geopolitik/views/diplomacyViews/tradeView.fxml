<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.msservices.geopolitik.controllers.diplomacy.treatyController"
            stylesheets="/com/msservices/geopolitik/styles/countryStyles/provinceStyles.css">

    <center>

        <VBox alignment="CENTER"
              spacing="15"
              styleClass="panel-provincia">

            <!-- Treaty image -->
            <Label fx:id="treatyImage"
                   prefWidth="70"
                   prefHeight="70"
                   styleClass="fila-dato"/>

            <!-- Treaty name -->
            <Label fx:id="treatyNameLabel"
                   text="Tratado"
                   styleClass="titulo"/>

            <!-- Countries -->
            <HBox alignment="CENTER"
                  spacing="30">

                <Label fx:id="sourceCountryFlag"
                       prefWidth="100"
                       prefHeight="50"
                       styleClass="fila-dato"/>

                <Label fx:id="treatyTypeImage"
                       prefWidth="60"
                       prefHeight="60"
                       styleClass="fila-dato"/>

                <Label fx:id="targetCountryFlag"
                       prefWidth="100"
                       prefHeight="50"
                       styleClass="fila-dato"/>

            </HBox>

            <!-- Action information -->
            <Label fx:id="actionInfoLabel"
                   text=""
                   wrapText="true"
                   alignment="CENTER"
                   maxWidth="420"
                   styleClass="texto-dato"/>

            <!-- Commercial agreement: resources -->
            <HBox fx:id="resourcesBox"
                  alignment="CENTER"
                  spacing="10"
                  visible="false"
                  managed="false">
                <ScrollPane fx:id="resourceScroll" fitToWidth="true" hbarPolicy="NEVER"
                            prefHeight="100" prefWidth="180">
                    <content>
                        <VBox fx:id="resourceList" spacing="5" styleClass="lista-scroll"/>
                    </content>
                </ScrollPane>
                <HBox alignment="CENTER" spacing="5">
                    <TextField fx:id="percentField" promptText="0"
                               prefWidth="50" maxWidth="50"
                               styleClass="lista-scroll"/>
                    <Label fx:id="percentLabel" text="\%" styleClass="texto-dato"/>
                </HBox>
            </HBox>

            <!-- Commercial agreement: agreement text -->
            <TextField fx:id="agreement"
                       promptText="Acuerdo"
                       prefWidth="180" maxWidth="180"
                       visible="false"
                       managed="false"
                       styleClass="lista-scroll"/>

            <!-- Economic support: available money and amount -->
            <HBox fx:id="moneyBox"
                  alignment="CENTER"
                  spacing="10"
                  visible="false"
                  managed="false">
                <Label text="Dinero disponible:" styleClass="texto-dato"/>
                <Label fx:id="moneyLabel" text="\$0" styleClass="texto-dato"/>
                <TextField fx:id="moneyField"
                           promptText="0"
                           prefWidth="120" maxWidth="120"
                           styleClass="lista-scroll"/>
            </HBox>

            <!-- Military support: empty list -->
            <ScrollPane fx:id="militaryListScroll"
                        fitToWidth="true"
                        minWidth="200"
                        prefHeight="100"
                        visible="false"
                        managed="false">
                <content>
                    <VBox fx:id="militaryList" spacing="5" styleClass="lista-scroll"/>
                </content>
            </ScrollPane>

            <!-- Ultimatum: empty list above the gauge -->
            <ScrollPane fx:id="ultimatumListScroll"
                        fitToWidth="true"
                        minWidth="200"
                        prefHeight="100"
                        visible="false"
                        managed="false">
                <content>
                    <VBox fx:id="ultimatumList" spacing="5" styleClass="lista-scroll"/>
                </content>
            </ScrollPane>

            <!-- Probability gauge -->
            <VBox fx:id="gaugeBox"
                  alignment="CENTER"
                  spacing="6"
                  visible="false"
                  managed="false">

                <Label text="Probabilidad de Éxito" styleClass="subtitulo"/>

                <Pane fx:id="probabilityGauge"
                      maxWidth="320"
                      maxHeight="40"
                      prefWidth="320"
                      prefHeight="40">

                    <!-- Gauge background -->
                    <Rectangle fx:id="gaugeBackground"
                               x="20"
                               y="14"
                               width="280"
                               height="12"
                               styleClass="icono"/>

                    <!-- Center marker -->
                    <Line startX="160"
                          startY="8"
                          endX="160"
                          endY="32"/>

                    <!-- Movable indicator -->
                    <Line fx:id="probabilityIndicator"
                          startX="160"
                          startY="8"
                          endX="160"
                          endY="32"/>

                </Pane>

                <!-- Labels -->
                <HBox prefWidth="320">

                    <Label text="Baja" styleClass="subtitulo"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="Alta" styleClass="subtitulo"/>

                </HBox>

            </VBox>

            <!-- Buttons -->
            <HBox alignment="CENTER"
                  spacing="20">

                <Button fx:id="signTreatyButton"
                        text="Firmar Tratado"
                        styleClass="boton-accion"/>

                <Button fx:id="backButton"
                        text="Atrás"
                        styleClass="boton-atras"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>
