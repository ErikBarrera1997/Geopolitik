<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.msservices.geopolitik.controllers.CountryViewControllers"
            stylesheets="/com/msservices/geopolitik/styles/countryStyles.css">

    <!-- Panel principal -->
    <center>
        <HBox spacing="10" alignment="CENTER">
            <!-- Mapa de provincias -->
            <Pane fx:id="mapaProvincias" prefWidth="500" prefHeight="400" styleClass="panel-mapa">
                <ImageView fitWidth="500" fitHeight="400" preserveRatio="true"/>
            </Pane>

            <!-- Panel derecho -->
            <VBox spacing="10" alignment="TOP_CENTER">
                <!-- Bandera -->
                <ImageView fx:id="bandera" fitWidth="120" fitHeight="60" preserveRatio="true" styleClass="bandera"/>
                <Label fx:id="lblNombrePais" text="Nombre" styleClass="titulo"/>

                <!-- Etiquetas amarillas -->
                <VBox spacing="8" alignment="CENTER_LEFT">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Rectangle fx:id="icon1" width="20" height="20" styleClass="icono"/>
                        <Label text="Capital:"/>
                    </HBox>
                    <Label fx:id="lblCapital" text="Valor" styleClass="valor"/>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Rectangle fx:id="icon2" width="20" height="20" styleClass="icono"/>
                        <Label text="Tipo de gobierno:"/>
                    </HBox>
                    <Label fx:id="lblGobierno" text="Valor" styleClass="valor"/>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Rectangle fx:id="icon3" width="20" height="20" styleClass="icono"/>
                        <Label text="Población:"/>
                    </HBox>
                    <Label fx:id="lblPoblacion" text="Valor" styleClass="valor"/>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Rectangle fx:id="icon4" width="20" height="20" styleClass="icono"/>
                        <Label text="Ingresos:"/>
                    </HBox>
                    <Label fx:id="lblIngresos" text="Valor" styleClass="valor"/>
                </VBox>

                <!-- Lista de provincias -->
                <Label text="Provincias" styleClass="subtitulo"/>
                <ScrollPane prefHeight="150" prefWidth="220" fitToWidth="true">
                    <VBox fx:id="provincias" spacing="5" styleClass="lista-provincias"/>
                </ScrollPane>

                <!-- Diplomacia -->
                <Rectangle fx:id="icon5" width="20" height="20" styleClass="icono"/>
                <Label text="Diplomacia"/>

                <!-- Botón atrás -->
                <Button fx:id="botonAtras" text="Atrás" styleClass="boton-atras"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
