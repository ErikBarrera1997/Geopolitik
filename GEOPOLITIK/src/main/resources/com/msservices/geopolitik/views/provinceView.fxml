<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.msservices.geopolitik.controllers.ProvinceViewControllers"
            stylesheets="/com/msservices/geopolitik/styles/provinceStyles.css">

    <center>
        <VBox spacing="10" alignment="TOP_CENTER" styleClass="panel-provincia">

            <!-- Encabezado -->
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="Provincia" styleClass="titulo"/>
                <Label fx:id="lblNombreProvincia" text="Nombre" styleClass="titulo"/>
            </HBox>

            <!-- Etiquetas amarillas con texto -->
            <VBox spacing="8" alignment="CENTER_LEFT">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Rectangle fx:id="iconPoblacion" width="20" height="20" styleClass="icono"/>
                    <Label text="Población:" styleClass="subtitulo"/>
                    <Label fx:id="valorPoblacion" text="000000" styleClass="texto-dato"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Rectangle fx:id="iconPIB" width="20" height="20" styleClass="icono"/>
                    <Label text="PIB:" styleClass="subtitulo"/>
                    <Label fx:id="valorPIB" text="0" styleClass="texto-dato"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Rectangle fx:id="iconSoberania" width="20" height="20" styleClass="icono"/>
                    <Label text="Soberanía:" styleClass="subtitulo"/>
                    <Label fx:id="valorSoberania" text="país" styleClass="texto-dato"/>
                </HBox>
            </VBox>

            <!-- Lista de recursos -->
            <Label text="Recursos" styleClass="subtitulo"/>
            <ScrollPane prefHeight="100" prefWidth="250" fitToWidth="true">
                <VBox fx:id="listaRecursos" spacing="5" styleClass="lista-scroll"/>
            </ScrollPane>

            <!-- Botones -->
            <HBox spacing="40" alignment="CENTER">
                <Button fx:id="botonAcciones" text="Acciones militares" styleClass="boton-accion"/>
                <Button fx:id="botonAtras" text="Atrás" styleClass="boton-atras"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
