<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.msservices.geopolitik.controllers.diplomacy.diplomacyActionsController"
            stylesheets="/com/msservices/geopolitik/styles/diplomacyStyles/diplomacyActionsStyles.css">

    <center>

        <VBox alignment="CENTER"
              spacing="10"
              styleClass="panel-acciones">

            <Label text="Acciones diplomáticas" styleClass="titulo"/>

            <ScrollPane fitToWidth="true" prefWidth="240" prefHeight="250">
                <VBox fx:id="actionsList" spacing="5" styleClass="lista-acciones"/>
            </ScrollPane>

            <Button fx:id="backButton"
                    text="Atrás"
                    styleClass="boton-atras"/>

        </VBox>
    </center>
</BorderPane>
